{
	"name": "agenty-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"licenses": "npm run licenses:shipped && npm run licenses:all",
		"licenses:shipped": "license-checker-rseidelsohn --production --excludePrivatePackages --summary --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD'",
		"licenses:all": "license-checker-rseidelsohn --excludePrivatePackages --summary --onlyAllow 'MIT;MIT-0;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;BlueOak-1.0.0;CC0-1.0;CC-BY-3.0;CC-BY-4.0;MPL-2.0'"
	},
	"dependencies": {
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^30.1.2",
		"license-checker-rseidelsohn": "^5.0.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	}
}
